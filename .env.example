# ==========================================
# EDUviber - Environment Config Template
# Copy this file to .env and configure your values.
# NEVER commit .env to version control!
# ==========================================

# Server Configuration
PORT=2000
NODE_ENV=development

# Primary Database & Session Storage (Development / Production)
# Use a least-privilege MongoDB Atlas user with readWrite access to your database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Dedicated Isolated Test Database (MANDATORY for running npm test)
# MUST be completely separate from your primary database (name must contain "test").
# Tests will NEVER run against MONGODB_URI and will abort if TEST_MONGODB_URI is not set.
TEST_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/eduviber-test-isolated?retryWrites=true&w=majority
# Minimum 32 cryptographically random characters in production
SESSION_SECRET=replace_with_a_super_secret_session_key_at_least_32_characters_long

# Initial Administrator Seeding (used by scripts/createAdmin.js)
ADMIN_NAME="Platform Administrator"
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PHONE="9999999999"
ADMIN_PASSWORD=ReplaceWithSecurePassword123!

# Bunny Stream Video CDN Integration
# Library ID (Numeric) from Bunny Stream Video Library settings
BUNNY_STREAM_LIBRARY_ID=123456
# Read/Write API Key from Bunny account
BUNNY_STREAM_API_KEY=your_bunny_stream_api_key_here
# CDN Hostname for player delivery
BUNNY_STREAM_CDN_HOSTNAME=vz-xxxx.b-cdn.net
# Embed Token Authentication Key (SHA-256 HMAC signing key)
BUNNY_STREAM_EMBED_TOKEN_KEY=your_embed_token_key_here

# Offline UPI / Bank Payment Instructions (Displayed on /courses/:slug/enroll)
PAYMENT_UPI_ID=merchant@bank
PAYMENT_ACCOUNT_NAME="EDUviber LLC"
PAYMENT_BANK_NAME="HDFC Bank"
PAYMENT_ACCOUNT_NUMBER="50200012345678"
PAYMENT_IFSC_CODE="HDFC0001234"

# Transactional Email Settings (SMTP / Resend / SendGrid / Postmark / Amazon SES)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=your_smtp_api_key_or_password
EMAIL_FROM="EDUviber <notifications@yourdomain.com>"

# Cloudinary Integration (Profile Picture & Image Assets)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
APP_BASE_URL=https://yourdomain.com
