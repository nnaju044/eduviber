<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Manage Lessons</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 text-gray-900">
    <main class="max-w-6xl mx-auto p-5 md:p-10">
        <a href="/admin/courses" class="text-sm text-gray-500 hover:text-gray-900">
            ← Back to courses
        </a>

        <header class="flex flex-wrap items-center justify-between gap-4 mt-5 mb-8">
            <div>
                <h1 class="text-3xl font-bold">
                    <%= course.title %>
                </h1>
                <p class="text-gray-500 mt-2">Manage modules and video lessons.</p>
            </div>

            <a href="/admin/courses/<%= course._id %>/lessons/new" class="bg-gray-900 text-white px-5 py-3 rounded-lg">
                + Add Lesson
            </a>
        </header>

        <section class="bg-white border rounded-xl overflow-hidden">
            <% if (lessons.length===0) { %>
                <div class="p-12 text-center">
                    <h2 class="text-xl font-semibold">No lessons yet</h2>
                    <p class="text-gray-500 mt-2">Start by adding your first lesson.</p>
                    <a href="/admin/courses/<%= course._id %>/lessons/new"
                        class="inline-block mt-5 bg-gray-900 text-white px-5 py-3 rounded-lg">
                        Add first lesson
                    </a>
                </div>
                <% } else { %>
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm text-left">
                            <thead class="bg-gray-100 text-gray-600">
                                <tr>
                                    <th class="p-4">Order</th>
                                    <th class="p-4">Lesson</th>
                                    <th class="p-4">Module</th>
                                    <th class="p-4">Video</th>
                                    <th class="p-4">Status</th>
                                    <th class="p-4">Action</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y">
                                <% lessons.forEach(lesson=> { %>
                                    <tr>
                                        <td class="p-4">
                                            <%= lesson.order %>
                                        </td>
                                        <td class="p-4 font-medium min-w-48">
                                            <%= lesson.title %>
                                                <p class="text-xs text-gray-500 mt-1">
                                                    <%= Math.floor(lesson.durationSeconds / 60) %> min
                                                </p>
                                        </td>
                                        <td class="p-4">
                                            <%= lesson.moduleName %>
                                        </td>
                                        <td class="p-4">
                                            <span
                                                class="<%= lesson.bunnyVideoId ? 'text-green-700' : 'text-gray-500' %>">
                                                <%= lesson.bunnyVideoId ? "Video ID added" : "No video" %>
                                            </span>
                                        </td>
                                        <td class="p-4">
                                            <span
                                                class="rounded-full px-3 py-1 text-xs <%= lesson.isPublished ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-800' %>">
                                                <%= lesson.isPublished ? "Published" : "Draft" %>
                                            </span>
                                        </td>
                                        <td class="p-4">
                                            <div class="flex items-center gap-3">
                                                <a href="/admin/courses/<%= course._id %>/lessons/<%= lesson._id %>/edit"
                                                    class="font-medium text-gray-700 hover:text-black hover:underline">
                                                    Edit
                                                </a>
                                                <span class="text-gray-300">|</span>
                                                <form
                                                    action="/admin/courses/<%= course._id %>/lessons/<%= lesson._id %>/toggle-publication"
                                                    method="POST" class="inline">
                                                    <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                                                    <button class="font-medium text-yellow-700 hover:underline">
                                                        <%= lesson.isPublished ? "Unpublish" : "Publish" %>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% } %>
        </section>
    </main>
</body>

</html>