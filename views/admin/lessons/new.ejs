<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Add Lesson</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 text-gray-900">
    <main class="max-w-3xl mx-auto p-5 md:p-10">
        <a href="/admin/courses/<%= course._id %>/lessons" class="text-sm text-gray-500 hover:text-gray-900">
            ← Back to lessons
        </a>

        <h1 class="text-3xl font-bold mt-5">Add lesson</h1>
        <p class="text-gray-500 mt-2 mb-8">
            <%= course.title %>
        </p>

        <% if (error) { %>
            <div role="alert" class="bg-red-50 text-red-700 p-4 rounded-lg mb-6">
                <%= error %>
            </div>
            <% } %>

                <form action="/admin/courses/<%= course._id %>/lessons" method="POST"
                    class="bg-white border rounded-xl p-6 md:p-8 space-y-5">
                    <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">

                    <div>
                        <label for="title" class="block text-sm font-medium mb-2">Lesson title *</label>
                        <input id="title" name="title" required maxlength="200" value="<%= values.title || '' %>"
                            placeholder="Introduction to the course" class="w-full border rounded-lg p-3">
                    </div>

                    <div>
                        <label for="description" class="block text-sm font-medium mb-2">Description</label>
                        <textarea id="description" name="description" rows="3"
                            class="w-full border rounded-lg p-3"><%= values.description || '' %></textarea>
                    </div>

                    <div>
                        <label for="moduleName" class="block text-sm font-medium mb-2">Module or day *</label>
                        <input id="moduleName" name="moduleName" required maxlength="100"
                            value="<%= values.moduleName || 'Module 1' %>" placeholder="Day 1"
                            class="w-full border rounded-lg p-3">
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div>
                            <label for="order" class="block text-sm font-medium mb-2">Lesson order *</label>
                            <input id="order" name="order" type="number" required min="1" max="10000"
                                value="<%= values.order || 1 %>" class="w-full border rounded-lg p-3">
                        </div>

                        <div>
                            <label for="durationSeconds" class="block text-sm font-medium mb-2">Duration in
                                seconds</label>
                            <input id="durationSeconds" name="durationSeconds" type="number" min="0" max="86400"
                                value="<%= values.durationSeconds || 0 %>" class="w-full border rounded-lg p-3">
                        </div>
                    </div>

                    <div>
                        <label for="bunnyVideoId" class="block text-sm font-medium mb-2">
                            Bunny Stream video ID
                        </label>
                        <input id="bunnyVideoId" name="bunnyVideoId" value="<%= values.bunnyVideoId || '' %>"
                            placeholder="Leave blank until your video is uploaded" class="w-full border rounded-lg p-3">
                        <p class="text-xs text-gray-500 mt-2">
                            We will connect Bunny Stream in the next phase.
                        </p>
                    </div>

                    <div class="rounded-lg bg-yellow-50 text-yellow-900 p-4 text-sm">
                        New lessons are saved as drafts. A lesson cannot be published until its course
                        is published and a video ID is attached.
                    </div>

                    <div class="flex flex-wrap gap-3">
                        <button type="submit" class="bg-gray-900 text-white px-6 py-3 rounded-lg font-medium">
                            Save Lesson
                        </button>
                        <a href="/admin/courses/<%= course._id %>/lessons"
                            class="border px-6 py-3 rounded-lg font-medium">
                            Cancel
                        </a>
                    </div>
                </form>
    </main>
</body>

</html>