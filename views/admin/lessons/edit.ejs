<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Edit Lesson | <%= lesson.title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 text-gray-900">
    <main class="max-w-3xl mx-auto p-5 md:p-10">
        <a href="/admin/courses/<%= course._id %>/lessons" class="text-sm text-gray-500 hover:text-gray-900">
            ← Back to lessons
        </a>

        <div class="mt-5 mb-8">
            <span class="text-xs uppercase tracking-wider text-gray-400 font-semibold"><%= course.title %></span>
            <h1 class="text-3xl font-bold mt-1">Edit Lesson</h1>
            <p class="text-gray-500 mt-1">Update module assignment, playback ordering, and Bunny Stream video ID.</p>
        </div>

        <% if (error) { %>
            <div role="alert" class="bg-red-50 text-red-700 p-4 rounded-lg mb-6 border border-red-200 text-sm">
                <%= error %>
            </div>
        <% } %>

        <form action="/admin/courses/<%= course._id %>/lessons/<%= lesson._id %>" method="POST"
            class="bg-white border rounded-xl p-6 md:p-8 space-y-6 shadow-sm">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">

            <div>
                <label for="title" class="block text-sm font-medium mb-2">Lesson title *</label>
                <input id="title" name="title" required maxlength="200" value="<%= values.title || '' %>"
                    placeholder="Introduction to the course" class="w-full border rounded-lg p-3 focus:ring-2 focus:ring-yellow-500 outline-none">
            </div>

            <div>
                <label for="description" class="block text-sm font-medium mb-2">Description</label>
                <textarea id="description" name="description" rows="3"
                    class="w-full border rounded-lg p-3 focus:ring-2 focus:ring-yellow-500 outline-none"><%= values.description || '' %></textarea>
            </div>

            <div>
                <label for="moduleName" class="block text-sm font-medium mb-2">Module or day *</label>
                <input id="moduleName" name="moduleName" required maxlength="100"
                    value="<%= values.moduleName || 'Module 1' %>" placeholder="Module 1"
                    class="w-full border rounded-lg p-3 focus:ring-2 focus:ring-yellow-500 outline-none">
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                    <label for="order" class="block text-sm font-medium mb-2">Lesson order *</label>
                    <input id="order" name="order" type="number" required min="1" max="10000"
                        value="<%= values.order !== undefined ? values.order : 1 %>"
                        class="w-full border rounded-lg p-3 focus:ring-2 focus:ring-yellow-500 outline-none">
                    <p class="text-xs text-gray-500 mt-1">Determines playback sequence within the course.</p>
                </div>

                <div>
                    <label for="durationSeconds" class="block text-sm font-medium mb-2">Duration (seconds)</label>
                    <input id="durationSeconds" name="durationSeconds" type="number" min="0" max="86400"
                        value="<%= values.durationSeconds !== undefined ? values.durationSeconds : 0 %>"
                        class="w-full border rounded-lg p-3 focus:ring-2 focus:ring-yellow-500 outline-none">
                    <p class="text-xs text-gray-500 mt-1">Approx <%= Math.floor((values.durationSeconds || 0) / 60) %> min</p>
                </div>
            </div>

            <div>
                <label for="bunnyVideoId" class="block text-sm font-medium mb-2">
                    Bunny Stream Video GUID
                </label>
                <input id="bunnyVideoId" name="bunnyVideoId" value="<%= values.bunnyVideoId || '' %>"
                    placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                    class="w-full border rounded-lg p-3 font-mono text-sm focus:ring-2 focus:ring-yellow-500 outline-none">
                <p class="text-xs text-gray-500 mt-1">
                    Direct video GUID from Bunny.net Stream video library.
                </p>
            </div>

            <div class="border-t pt-5">
                <label class="block font-medium text-sm mb-2">Publication State</label>
                <div class="flex items-center gap-3">
                    <label class="inline-flex items-center cursor-pointer">
                        <input type="checkbox" name="isPublished" value="true" class="sr-only peer" <%= values.isPublished ? 'checked' : '' %>>
                        <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-green-600"></div>
                        <span class="ml-3 text-sm font-medium text-gray-700">
                            <%= values.isPublished ? 'Published (visible to enrolled students)' : 'Draft (hidden)' %>
                        </span>
                    </label>
                </div>
                <p class="text-xs text-amber-700 bg-amber-50 rounded p-2 mt-2">
                    Guard: A lesson cannot be published unless the parent course is published and a valid Bunny Stream video ID is attached.
                </p>
            </div>

            <div class="flex flex-wrap gap-3 pt-3">
                <button type="submit" class="bg-gray-900 text-white px-6 py-3 rounded-lg font-medium hover:bg-gray-800 transition">
                    Save Changes
                </button>
                <a href="/admin/courses/<%= course._id %>/lessons"
                    class="border px-6 py-3 rounded-lg font-medium hover:bg-gray-50 transition">
                    Cancel
                </a>
            </div>
        </form>

        <!-- Danger Zone: Lesson Deletion -->
        <section class="mt-10 bg-white border border-red-200 rounded-xl p-6 md:p-8">
            <h2 class="text-lg font-bold text-red-900">Danger Zone</h2>
            <p class="text-sm text-gray-600 mt-1 mb-4">
                Delete this lesson from <span class="font-semibold"><%= course.title %></span>.
            </p>

            <% if (progressCount > 0) { %>
                <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 text-sm text-amber-900 mb-4">
                    <p class="font-semibold">Student progress exists for this lesson:</p>
                    <p class="text-xs mt-1">
                        <strong><%= progressCount %></strong> student(s) have tracked watch history or completion status on this lesson. Unpublishing is strongly recommended so you do not disrupt their progress analytics.
                    </p>
                </div>

                <form action="/admin/courses/<%= course._id %>/lessons/<%= lesson._id %>/delete" method="POST"
                    onsubmit="return confirm('Students have completed or watched this lesson. Are you sure you want to delete it anyway?');"
                    class="space-y-4">
                    <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                    <input type="hidden" name="confirm" value="DELETE">
                    <button type="submit" class="bg-red-600 text-white px-5 py-2.5 rounded-lg text-sm font-semibold hover:bg-red-700 transition">
                        Delete Lesson Anyway
                    </button>
                </form>
            <% } else { %>
                <form action="/admin/courses/<%= course._id %>/lessons/<%= lesson._id %>/delete" method="POST"
                    onsubmit="return confirm('Are you sure you want to delete this lesson?');">
                    <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                    <button type="submit" class="bg-red-600 text-white px-5 py-2.5 rounded-lg text-sm font-semibold hover:bg-red-700 transition">
                        Delete Lesson
                    </button>
                </form>
            <% } %>
        </section>
    </main>
</body>

</html>
