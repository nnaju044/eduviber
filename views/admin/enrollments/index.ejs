<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Manage Enrollments | Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 text-gray-900">
    <div class="min-h-screen md:flex">
        <!-- Sidebar -->
        <aside class="bg-white border-r border-gray-200 p-6 md:w-64 shrink-0">
            <a href="/admin" class="text-2xl font-bold">
                EDUviber<span class="text-yellow-600">.</span>
            </a>
            <p class="text-xs text-gray-500 mt-2">ADMINISTRATION</p>

            <nav class="mt-8 space-y-2">
                <a href="/admin" class="block rounded-lg px-4 py-3 hover:bg-gray-100">Dashboard</a>
                <a href="/admin/courses" class="block rounded-lg px-4 py-3 hover:bg-gray-100">Courses</a>
                <a href="/admin/students" class="block rounded-lg px-4 py-3 hover:bg-gray-100">Students</a>
                <a href="/admin/enrollments" class="block bg-gray-900 text-white rounded-lg px-4 py-3">Enrollments</a>
                <a href="/admin/courses/new" class="block rounded-lg px-4 py-3 hover:bg-gray-100">Create Course</a>
            </nav>

            <form action="/logout" method="POST" class="mt-8">
                <button class="text-sm text-gray-600 hover:text-red-600">Log out</button>
            </form>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 p-5 md:p-10 space-y-8">
            <header class="flex flex-wrap items-center justify-between gap-4">
                <div>
                    <h1 class="text-3xl font-bold">Enrollment Management</h1>
                    <p class="text-gray-500 mt-1">
                        Control student course permissions, activate pending orders, or suspend access.
                    </p>
                </div>
            </header>

            <!-- Manual Enrollment Card -->
            <section class="bg-white border border-gray-200 rounded-2xl p-6 shadow-xs">
                <h2 class="text-lg font-bold text-gray-900 mb-1">Manual Student Enrollment</h2>
                <p class="text-xs text-gray-500 mb-5">Assign access to a published course for an existing student.</p>

                <% if (students.length === 0) { %>
                    <p class="text-xs text-gray-500 italic bg-gray-50 p-4 rounded-xl border border-gray-200">
                        No active student accounts exist. Please <a href="/admin/students/new" class="text-yellow-700 underline font-semibold">create a student account</a> first.
                    </p>
                <% } else if (publishedCourses.length === 0) { %>
                    <p class="text-xs text-gray-500 italic bg-gray-50 p-4 rounded-xl border border-gray-200">
                        No published courses exist. Please <a href="/admin/courses" class="text-yellow-700 underline font-semibold">publish a course</a> before assigning enrollments.
                    </p>
                <% } else { %>
                    <form action="/admin/enrollments" method="POST" class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
                        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                        <input type="hidden" name="redirectUrl" value="/admin/enrollments">

                        <div>
                            <label for="userId" class="block text-xs font-semibold text-gray-700 mb-1.5">
                                Select Student *
                            </label>
                            <select id="userId" name="userId" required
                                class="w-full border border-gray-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-yellow-500 outline-hidden">
                                <option value="">-- Choose Student --</option>
                                <% students.forEach(s => { %>
                                    <option value="<%= s._id %>"><%= s.name %> (<%= s.email %>)</option>
                                <% }) %>
                            </select>
                        </div>

                        <div>
                            <label for="courseId" class="block text-xs font-semibold text-gray-700 mb-1.5">
                                Select Published Course *
                            </label>
                            <select id="courseId" name="courseId" required
                                class="w-full border border-gray-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-yellow-500 outline-hidden">
                                <option value="">-- Choose Course --</option>
                                <% publishedCourses.forEach(c => { %>
                                    <option value="<%= c._id %>"><%= c.title %> (₹<%= c.price.toLocaleString("en-IN") %>)</option>
                                <% }) %>
                            </select>
                        </div>

                        <div>
                            <label for="status" class="block text-xs font-semibold text-gray-700 mb-1.5">
                                Initial Access Status *
                            </label>
                            <select id="status" name="status" required
                                class="w-full border border-gray-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-yellow-500 outline-hidden">
                                <option value="active" selected>Active (Immediate Access)</option>
                                <option value="pending">Pending (Awaiting Verification)</option>
                                <option value="suspended">Suspended</option>
                            </select>
                        </div>

                        <div>
                            <button type="submit"
                                class="w-full bg-gray-900 hover:bg-black text-white px-5 py-2.5 rounded-lg text-sm font-semibold transition-colors shadow-xs">
                                + Assign Course
                            </button>
                        </div>
                    </form>
                <% } %>
            </section>

            <!-- Status Filter Tabs -->
            <section class="flex flex-wrap gap-2 border-b border-gray-200 pb-3 text-sm">
                <% const tabs = [
                    { id: '', label: 'All Enrollments' },
                    { id: 'active', label: 'Active' },
                    { id: 'pending', label: 'Pending' },
                    { id: 'suspended', label: 'Suspended' },
                    { id: 'expired', label: 'Expired' }
                ]; %>
                <% tabs.forEach(tab => { %>
                    <a href="/admin/enrollments<%= tab.id ? '?status=' + tab.id : '' %>"
                        class="px-4 py-2 rounded-lg font-medium text-xs transition-colors <%= currentStatus === tab.id ? 'bg-gray-900 text-white' : 'bg-white border border-gray-200 text-gray-600 hover:bg-gray-50' %>">
                        <%= tab.label %>
                    </a>
                <% }) %>
            </section>

            <!-- Enrollments Table -->
            <section class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-xs">
                <% if (enrollments.length === 0) { %>
                    <div class="p-12 text-center">
                        <h3 class="text-lg font-bold text-gray-900">No enrollments found</h3>
                        <p class="text-xs text-gray-500 mt-1">
                            <%= currentStatus ? 'No records match the selected status filter.' : 'No course enrollments have been created yet.' %>
                        </p>
                    </div>
                <% } else { %>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm">
                            <thead class="bg-gray-50 text-gray-500 border-b border-gray-200">
                                <tr>
                                    <th class="p-4 font-semibold">Student</th>
                                    <th class="p-4 font-semibold">Course</th>
                                    <th class="p-4 font-semibold">Status</th>
                                    <th class="p-4 font-semibold">Enrolled On</th>
                                    <th class="p-4 font-semibold">Approved On</th>
                                    <th class="p-4 font-semibold">Change Status</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100">
                                <% enrollments.forEach(enrollment => { %>
                                    <tr class="hover:bg-gray-50/50 transition-colors">
                                        <td class="p-4 min-w-44">
                                            <% if (enrollment.userId) { %>
                                                <a href="/admin/students/<%= enrollment.userId._id %>" class="font-medium text-gray-900 hover:underline">
                                                    <%= enrollment.userId.name %>
                                                </a>
                                                <p class="text-xs text-gray-500 mt-0.5"><%= enrollment.userId.email %></p>
                                            <% } else { %>
                                                <span class="text-xs text-gray-400 italic">User deleted</span>
                                            <% } %>
                                        </td>
                                        <td class="p-4 min-w-44">
                                            <% if (enrollment.courseId) { %>
                                                <span class="font-semibold text-gray-900"><%= enrollment.courseId.title %></span>
                                                <p class="text-xs text-gray-500">₹<%= enrollment.courseId.price.toLocaleString("en-IN") %></p>
                                            <% } else { %>
                                                <span class="text-xs text-gray-400 italic">Course deleted</span>
                                            <% } %>
                                        </td>
                                        <td class="p-4">
                                            <% const statusStyles = {
                                                active: 'bg-green-100 text-green-800',
                                                pending: 'bg-yellow-100 text-yellow-800',
                                                suspended: 'bg-red-100 text-red-800',
                                                expired: 'bg-gray-100 text-gray-700'
                                            }; %>
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold capitalize <%= statusStyles[enrollment.status] || 'bg-gray-100 text-gray-700' %>">
                                                <%= enrollment.status %>
                                            </span>
                                        </td>
                                        <td class="p-4 text-xs text-gray-500">
                                            <%= new Date(enrollment.createdAt).toLocaleDateString() %>
                                        </td>
                                        <td class="p-4 text-xs text-gray-500">
                                            <%= enrollment.approvedAt ? new Date(enrollment.approvedAt).toLocaleDateString() : '—' %>
                                        </td>
                                        <td class="p-4">
                                            <form action="/admin/enrollments/<%= enrollment._id %>/status" method="POST" class="flex items-center gap-2">
                                                <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                                                <input type="hidden" name="redirectUrl" value="/admin/enrollments<%= currentStatus ? '?status=' + currentStatus : '' %>">
                                                <select name="status"
                                                    class="text-xs border border-gray-300 rounded-lg p-1.5 focus:ring-1 focus:ring-yellow-500 outline-hidden">
                                                    <option value="active" <%= enrollment.status === 'active' ? 'selected' : '' %>>Active</option>
                                                    <option value="pending" <%= enrollment.status === 'pending' ? 'selected' : '' %>>Pending</option>
                                                    <option value="suspended" <%= enrollment.status === 'suspended' ? 'selected' : '' %>>Suspended</option>
                                                    <option value="expired" <%= enrollment.status === 'expired' ? 'selected' : '' %>>Expired</option>
                                                </select>
                                                <button type="submit"
                                                    class="text-xs bg-gray-900 hover:bg-black text-white px-2.5 py-1.5 rounded-lg font-medium transition-colors">
                                                    Update
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <% if (totalPages > 1) { %>
                        <div class="p-4 border-t border-gray-200 flex items-center justify-between text-xs text-gray-500">
                            <div>
                                Page <%= page %> of <%= totalPages %> (<%= totalCount %> total enrollments)
                            </div>
                            <div class="flex gap-2">
                                <% if (page > 1) { %>
                                    <a href="/admin/enrollments?page=<%= page - 1 %><%= currentStatus ? '&status=' + currentStatus : '' %>"
                                        class="px-3 py-1.5 border rounded-lg hover:bg-gray-50 text-gray-700 font-medium">
                                        ← Previous
                                    </a>
                                <% } %>
                                <% if (page < totalPages) { %>
                                    <a href="/admin/enrollments?page=<%= page + 1 %><%= currentStatus ? '&status=' + currentStatus : '' %>"
                                        class="px-3 py-1.5 border rounded-lg hover:bg-gray-50 text-gray-700 font-medium">
                                        Next →
                                    </a>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                <% } %>
            </section>
        </main>
    </div>
</body>

</html>
