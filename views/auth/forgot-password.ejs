<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Forgot Password | EDUviber</title>
    <link rel="icon" type="image/png" href="/images/EDUviber_LOGO.png">
    <link rel="apple-touch-icon" href="/images/EDUviber_LOGO.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ["'Plus Jakarta Sans'", "sans-serif"],
                    },
                    colors: {
                        gold: "#CA8A04",
                        goldHover: "#A16207",
                    }
                }
            }
        }
    </script>
</head>

<body
    class="min-h-screen bg-[#FAFAFA] text-neutral-900 flex items-center justify-center p-4 font-sans antialiased selection:bg-[#CA8A04] selection:text-white">
    <main class="w-full max-w-md bg-white rounded-2xl border border-neutral-200/80 p-8 shadow-sm">
        <div class="mb-8 text-center">
            <a href="/app" class="inline-block font-black text-3xl tracking-tight text-black select-none">
                EDU<span class="text-[#CA8A04]">viber</span>
            </a>
            <h1 class="text-2xl font-black text-neutral-900 mt-5 tracking-tight">Reset your password</h1>
            <p class="text-neutral-500 mt-2 text-sm font-medium">
                Enter your registered email address to receive password reset instructions.
            </p>
        </div>

        <% if (locals.submitted) { %>
            <div class="rounded-xl bg-emerald-50 border border-emerald-200 p-4 mb-6">
                <div class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-emerald-600 mt-0.5 shrink-0" fill="none" stroke="currentColor"
                        viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <div>
                        <h2 class="text-sm font-bold text-emerald-900">Check your email</h2>
                        <p class="text-xs text-emerald-800 mt-1 leading-relaxed font-medium">
                            If an active account exists with that email address, password reset instructions have been
                            sent. Please check your inbox and spam folder.
                        </p>
                    </div>
                </div>
            </div>

            <div class="text-center pt-2">
                <a href="/app/login"
                    class="inline-flex items-center justify-center w-full text-center rounded-xl bg-black text-white font-bold p-3.5 hover:bg-neutral-800 transition shadow-xs text-sm min-h-[44px]">
                    Return to Sign In
                </a>
            </div>
            <% } else { %>

                <% if (locals.error) { %>
                    <div role="alert"
                        class="mb-5 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 p-3.5 text-sm font-semibold">
                        <%= error %>
                    </div>
                    <% } %>

                        <form method="POST" action="/forgot-password" class="space-y-5">
                            <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                            <div>
                                <label for="email" class="block text-sm font-bold text-neutral-800 mb-1.5">Registered
                                    email address</label>
                                <input id="email" name="email" type="email" autocomplete="email" required
                                    placeholder="you@example.com" value="<%= locals.email || '' %>"
                                    class="w-full rounded-xl border border-neutral-300 p-3.5 text-sm focus:ring-2 focus:ring-[#CA8A04] focus:border-[#CA8A04] outline-none min-h-[44px]">
                            </div>

                            <button type="submit"
                                class="w-full rounded-xl bg-black text-white font-bold p-3.5 hover:bg-neutral-800 transition shadow-xs text-sm min-h-[44px]">
                                Send password reset instructions
                            </button>
                        </form>

                        <div class="text-center mt-6">
                            <a href="/app/login" class="text-sm text-neutral-600 hover:text-black font-bold transition">
                                &larr; Back to sign in
                            </a>
                        </div>
                        <% } %>

                            <p class="text-center text-xs text-neutral-400 mt-8 font-medium">
                                Secure password recovery for registered students and instructors.
                            </p>
    </main>
</body>

</html>