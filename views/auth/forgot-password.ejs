<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Forgot Password | EDUviber</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-gray-50 flex items-center justify-center p-5">
    <main class="w-full max-w-md bg-white rounded-2xl border border-gray-200 p-8 shadow-sm">
        <div class="mb-8 text-center">
            <div class="text-3xl font-bold text-gray-900">EDUviber<span class="text-yellow-600">.</span></div>
            <h1 class="text-2xl font-semibold mt-5">Reset your password</h1>
            <p class="text-gray-500 mt-2 text-sm">
                Enter your email address to receive password reset instructions.
            </p>
        </div>

        <% if (locals.submitted) { %>
            <div class="rounded-xl bg-emerald-50 border border-emerald-200 p-4 mb-6">
                <div class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-emerald-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <div>
                        <h2 class="text-sm font-semibold text-emerald-900">Check your email</h2>
                        <p class="text-xs text-emerald-800 mt-1 leading-relaxed">
                            If an active account exists with that email address, password reset instructions have been sent. Please check your inbox and spam folder.
                        </p>
                    </div>
                </div>
            </div>

            <div class="text-center pt-2">
                <a href="/login"
                    class="inline-block w-full text-center rounded-lg bg-gray-900 text-white font-semibold p-3 hover:bg-gray-800 transition">
                    Return to Sign in
                </a>
            </div>
        <% } else { %>

            <% if (locals.error) { %>
                <div role="alert" class="mb-5 rounded-lg bg-red-50 text-red-700 p-3 text-sm">
                    <%= error %>
                </div>
            <% } %>

            <form method="POST" action="/forgot-password" class="space-y-5">
                <div>
                    <label for="email" class="block text-sm font-medium mb-2">Registered email address</label>
                    <input id="email" name="email" type="email" autocomplete="email" required
                        placeholder="you@example.com"
                        value="<%= locals.email || '' %>"
                        class="w-full rounded-lg border border-gray-300 p-3 focus:ring-2 focus:ring-yellow-500 outline-none">
                </div>

                <button type="submit"
                    class="w-full rounded-lg bg-gray-900 text-white font-semibold p-3 hover:bg-gray-800 transition">
                    Send password reset instructions
                </button>
            </form>

            <div class="text-center mt-6">
                <a href="/login" class="text-sm text-gray-600 hover:text-yellow-700 font-medium">
                    &larr; Back to sign in
                </a>
            </div>
        <% } %>

        <p class="text-center text-xs text-gray-500 mt-7">
            Secure password recovery for registered students and instructors.
        </p>
    </main>
</body>

</html>
