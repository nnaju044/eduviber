<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Account Required | <%= course.title %> | EDUviber</title>
    <link rel="icon" type="image/png" href="/images/EDUviber_LOGO.png">
    <link rel="apple-touch-icon" href="/images/EDUviber_LOGO.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ["'Plus Jakarta Sans'", "sans-serif"],
                    },
                    colors: {
                        gold: "#CA8A04",
                        goldHover: "#A16207",
                    }
                }
            }
        }
    </script>
</head>

<body
    class="bg-[#FAFAFA] text-neutral-900 min-h-screen flex flex-col font-sans antialiased selection:bg-[#CA8A04] selection:text-white">
    <!-- Navigation Bar -->
    <header class="bg-white/90 backdrop-blur-md border-b border-neutral-200 sticky top-0 z-30">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
            <a href="/app" class="font-black text-2xl tracking-tight text-black flex items-center gap-1 select-none">
                EDU<span class="text-[#CA8A04]">viber</span>
            </a>

            <nav class="flex items-center gap-4">
                <a href="/courses/<%= course.slug %>"
                    class="text-xs font-bold uppercase tracking-wider text-neutral-600 hover:text-black transition min-h-[36px] flex items-center">
                    ← Back to Course
                </a>
            </nav>
        </div>
    </header>

    <main class="flex-1 flex items-center justify-center p-4">
        <div class="w-full max-w-md bg-white border border-neutral-200/80 rounded-2xl p-8 shadow-sm text-center">
            <div
                class="w-14 h-14 bg-[#CA8A04]/10 text-[#CA8A04] border border-[#CA8A04]/20 rounded-2xl flex items-center justify-center mx-auto mb-5">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
            </div>

            <h1 class="text-2xl font-black text-neutral-900 tracking-tight">Account Required</h1>
            <p class="text-sm text-neutral-600 mt-2 leading-relaxed font-medium">
                To link your enrollment for <strong class="text-neutral-900 font-bold">
                    <%= course.title %>
                </strong> to your personal student dashboard, please sign in first.
            </p>

            <div
                class="bg-neutral-50 border border-neutral-200 rounded-xl p-4 mt-6 text-left text-xs space-y-2 text-neutral-600">
                <div class="flex justify-between font-bold text-neutral-900">
                    <span>Course:</span>
                    <span class="text-right truncate ml-2">
                        <%= course.title %>
                    </span>
                </div>
                <div class="flex justify-between font-semibold">
                    <span>Payable Fee:</span>
                    <span class="font-black text-neutral-900 text-sm">₹<%= course.price.toLocaleString("en-IN") %>
                            </span>
                </div>
            </div>

            <div class="mt-8 space-y-3">
                <a href="/app/login?redirect=/courses/<%= course.slug %>/enroll"
                    class="inline-flex items-center justify-center w-full bg-black hover:bg-neutral-800 text-white font-bold py-3.5 px-4 rounded-xl transition shadow-xs text-sm min-h-[44px]">
                    Sign In to Continue →
                </a>
                <a href="/courses/<%= course.slug %>"
                    class="block text-xs font-semibold text-neutral-500 hover:text-black transition">
                    Cancel and return to course syllabus
                </a>
            </div>
        </div>
    </main>
</body>

</html>