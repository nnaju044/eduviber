<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Payment Submitted | EDUviber</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col antialiased">
    <!-- Header -->
    <header class="bg-white border-b border-gray-200">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
            <a href="/" class="font-bold text-2xl tracking-tight text-gray-900 flex items-center gap-1">
                EDUviber<span class="text-yellow-600">.</span>
            </a>

            <nav class="flex items-center gap-4">
                <a href="/dashboard" class="text-sm font-medium text-gray-600 hover:text-gray-900">
                    Dashboard
                </a>
            </nav>
        </div>
    </header>

    <main class="flex-1 flex items-center justify-center p-4">
        <div class="w-full max-w-lg bg-white border border-gray-200 rounded-3xl p-8 sm:p-10 shadow-xs text-center space-y-6">
            <div class="w-16 h-16 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center mx-auto">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M5 13l4 4L19 7" />
                </svg>
            </div>

            <div>
                <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900">
                    Payment Reference Submitted!
                </h1>
                <p class="text-sm text-gray-600 mt-2 leading-relaxed">
                    Thank you, <strong class="text-gray-900"><%= user.name %></strong>. Your transaction reference for <strong class="text-gray-900"><%= course.title %></strong> has been received and is pending administrator verification.
                </p>
            </div>

            <div class="bg-gray-50 border border-gray-200 rounded-2xl p-5 text-left text-xs space-y-2 text-gray-600">
                <div class="flex justify-between">
                    <span class="font-medium text-gray-500">Course:</span>
                    <span class="font-bold text-gray-900 text-right"><%= course.title %></span>
                </div>
                <div class="flex justify-between">
                    <span class="font-medium text-gray-500">Amount:</span>
                    <span class="font-bold text-gray-900">₹<%= payment.amount.toLocaleString("en-IN") %></span>
                </div>
                <div class="flex justify-between">
                    <span class="font-medium text-gray-500">Transaction Ref:</span>
                    <span class="font-mono font-bold text-gray-900 bg-white px-2 py-0.5 rounded border border-gray-200"><%= payment.transactionReference %></span>
                </div>
                <div class="flex justify-between">
                    <span class="font-medium text-gray-500">Status:</span>
                    <span class="font-bold text-amber-700 bg-amber-100 px-2 py-0.5 rounded-full uppercase tracking-wider text-[10px]">
                        <%= payment.status %>
                    </span>
                </div>
            </div>

            <div class="text-xs text-gray-500 bg-blue-50/60 border border-blue-200 text-blue-900 rounded-xl p-4 text-left leading-relaxed">
                <p class="font-semibold text-blue-950 mb-1">What happens next?</p>
                Our administration team reviews transaction confirmations against our bank statements. Once verified, the course will appear under "My Courses" in your student dashboard automatically.
            </div>

            <div class="pt-2 flex flex-col sm:flex-row gap-3">
                <a href="/dashboard"
                    class="flex-1 bg-gray-900 hover:bg-black text-white font-semibold py-3.5 px-4 rounded-xl transition-colors shadow-xs text-sm">
                    Go to Student Dashboard
                </a>
                <a href="/courses"
                    class="border border-gray-300 hover:bg-gray-50 text-gray-700 font-semibold py-3.5 px-4 rounded-xl transition-colors text-sm">
                    Browse More Courses
                </a>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-gray-200 py-6">
        <div class="max-w-4xl mx-auto px-4 text-center text-xs text-gray-500">
            <p>© <%= new Date().getFullYear() %> EDUviber. All rights reserved.</p>
        </div>
    </footer>
</body>

</html>
