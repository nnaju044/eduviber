<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
        <%= course.title %> | EDUviber
    </title>
    <link rel="icon" type="image/png" href="/images/EDUviber_LOGO.png">
    <link rel="apple-touch-icon" href="/images/EDUviber_LOGO.png">
    <meta name="description" content="<%= course.description.slice(0, 160) %>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ["'Plus Jakarta Sans'", "sans-serif"],
                    },
                    colors: {
                        gold: "#CA8A04",
                        goldHover: "#A16207",
                    }
                }
            }
        }
    </script>
</head>

<body
    class="bg-[#FAFAFA] text-neutral-900 min-h-screen flex flex-col font-sans antialiased selection:bg-[#CA8A04] selection:text-white">
    <!-- Navigation Bar -->
    <header class="bg-white/90 backdrop-blur-md border-b border-neutral-200 sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <a href="/app" class="font-black text-2xl tracking-tight text-black flex items-center gap-1 select-none">
                EDU<span class="text-[#CA8A04]">viber</span>
            </a>

            <nav class="flex items-center gap-4 sm:gap-6 text-sm font-semibold">
                <a href="/app" class="text-neutral-600 hover:text-black transition">
                    Home
                </a>
                <a href="/courses" class="text-black font-bold border-b-2 border-[#CA8A04] pb-0.5">
                    Courses
                </a>

                <% if (user) { %>
                    <a href="<%= user.role === 'admin' || user.role === 'super_admin' ? '/app/admin' : user.role === 'teacher' ? '/app/teacher' : '/app/student' %>"
                        class="inline-flex items-center gap-2 bg-black hover:bg-neutral-800 text-white text-xs font-bold px-4 py-2 rounded-xl transition shadow-sm min-h-[40px]">
                        <span>Dashboard</span>
                        <span>→</span>
                    </a>
                    <% } else { %>
                        <a href="/app/login"
                            class="inline-flex items-center text-xs font-bold text-black border border-neutral-300 hover:bg-neutral-50 px-4 py-2 rounded-xl transition min-h-[40px]">
                            Sign In
                        </a>
                        <% } %>
            </nav>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-1 w-full space-y-8">
        <div>
            <a href="/courses"
                class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-neutral-500 hover:text-black transition min-h-[36px]">
                ← Back to Course Catalog
            </a>
        </div>

        <!-- Course Header Hero Card -->
        <div class="bg-white border border-neutral-200/80 rounded-2xl p-6 sm:p-10 shadow-xs">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
                <!-- Course Overview (Left 2 Cols) -->
                <div class="lg:col-span-2 space-y-4">
                    <div class="flex flex-wrap items-center gap-3">
                        <span
                            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-[#CA8A04]/10 border border-[#CA8A04]/20 text-[#CA8A04]">
                            <span class="w-1.5 h-1.5 rounded-full bg-[#CA8A04]"></span>
                            Verified Curriculum
                        </span>
                        <% if (course.instructor) { %>
                            <span class="text-xs font-semibold text-neutral-500">
                                Instructor: <strong class="text-neutral-900 font-bold">
                                    <%= course.instructor %>
                                </strong>
                            </span>
                            <% } %>
                    </div>

                    <h1 class="text-3xl sm:text-4xl font-black text-neutral-900 tracking-tight leading-tight">
                        <%= course.title %>
                    </h1>

                    <p class="text-base text-neutral-600 leading-relaxed whitespace-pre-line font-medium">
                        <%= course.description %>
                    </p>

                    <!-- Quick Metrics -->
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-4 border-t border-neutral-100 text-sm">
                        <div class="bg-neutral-50/80 p-3 rounded-xl border border-neutral-100">
                            <span
                                class="text-neutral-400 block text-xs uppercase font-bold tracking-wider">Curriculum</span>
                            <span class="font-extrabold text-neutral-900 text-base">
                                <%= totalLessons %>
                                    <%= totalLessons===1 ? 'Lesson' : 'Lessons' %>
                            </span>
                        </div>
                        <div class="bg-neutral-50/80 p-3 rounded-xl border border-neutral-100">
                            <span
                                class="text-neutral-400 block text-xs uppercase font-bold tracking-wider">Duration</span>
                            <span class="font-extrabold text-neutral-900 text-base">
                                <%= totalMinutes> 0 ? totalMinutes + ' Minutes' : 'Self-Paced' %>
                            </span>
                        </div>
                        <div class="bg-neutral-50/80 p-3 rounded-xl border border-neutral-100">
                            <span
                                class="text-neutral-400 block text-xs uppercase font-bold tracking-wider">Access</span>
                            <span class="font-extrabold text-neutral-900 text-base">Lifetime</span>
                        </div>
                    </div>
                </div>

                <!-- Course Action Card (Right Col) -->
                <div
                    class="bg-neutral-50/70 border border-neutral-200/80 rounded-2xl p-6 flex flex-col justify-between space-y-6">
                    <!-- Thumbnail Preview -->
                    <div
                        class="w-full h-44 bg-neutral-900 rounded-xl overflow-hidden relative border border-neutral-200 shadow-inner">
                        <% if (course.thumbnail) { %>
                            <img src="<%= course.thumbnail %>" alt="<%= course.title %>"
                                class="w-full h-full object-cover"
                                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                            <div class="hidden w-full h-full items-center justify-center p-4 text-white text-center">
                                <p class="text-base font-bold">
                                    <%= course.title %>
                                </p>
                            </div>
                            <% } else { %>
                                <div
                                    class="w-full h-full flex flex-col items-center justify-center p-4 text-white text-center bg-black">
                                    <span class="text-2xl font-black text-[#CA8A04]">EDUviber.</span>
                                    <p class="text-xs font-semibold mt-1 px-2 line-clamp-2 text-neutral-300">
                                        <%= course.title %>
                                    </p>
                                </div>
                                <% } %>
                    </div>

                    <!-- Price & Purchase CTA -->
                    <div class="space-y-4">
                        <div>
                            <span class="text-xs text-neutral-500 uppercase font-bold tracking-wider block">Enrollment
                                Fee</span>
                            <div class="flex items-baseline gap-2 mt-1">
                                <span class="text-3xl font-black text-neutral-900">
                                    ₹<%= course.price.toLocaleString("en-IN") %>
                                </span>
                                <span class="text-xs text-neutral-500 font-semibold">one-time payment</span>
                            </div>
                        </div>

                        <% if (isEnrolled) { %>
                            <div
                                class="bg-emerald-50 border border-emerald-200 text-emerald-900 p-4 rounded-xl text-xs space-y-2">
                                <p class="font-bold flex items-center gap-1.5 text-emerald-800">
                                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                    You have active access to this course!
                                </p>
                                <a href="/app/student"
                                    class="inline-flex items-center justify-center w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-4 rounded-xl transition shadow-xs text-xs min-h-[44px]">
                                    Open in Student Dashboard →
                                </a>
                            </div>
                            <% } else { %>
                                <a href="/courses/<%= course.slug %>/enroll"
                                    class="inline-flex items-center justify-center w-full bg-black hover:bg-neutral-800 text-white font-bold py-3.5 px-4 rounded-xl transition shadow-sm text-sm text-center min-h-[44px]">
                                    Enroll Now →
                                </a>

                                <div class="text-xs text-neutral-500 space-y-2 pt-2">
                                    <p class="flex items-center gap-2">
                                        <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="currentColor"
                                            viewBox="0 0 20 20">
                                            <path fill-rule="evenodd"
                                                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                                clip-rule="evenodd" />
                                        </svg>
                                        Direct video streaming with auto-resume
                                    </p>
                                    <p class="flex items-center gap-2">
                                        <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="currentColor"
                                            viewBox="0 0 20 20">
                                            <path fill-rule="evenodd"
                                                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                                clip-rule="evenodd" />
                                        </svg>
                                        Manual verification & direct student support
                                    </p>
                                </div>
                                <% } %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Curriculum Preview Section -->
        <section class="bg-white border border-neutral-200/80 rounded-2xl p-6 sm:p-10 shadow-xs">
            <div class="flex items-center justify-between mb-8">
                <div>
                    <h2 class="text-2xl font-black tracking-tight text-neutral-900">
                        Course Curriculum
                    </h2>
                    <p class="text-neutral-500 text-sm mt-1 font-medium">
                        <%= totalLessons %>
                            <%= totalLessons===1 ? 'lesson' : 'lessons' %> organized across <%= modules.length %>
                                    <%= modules.length===1 ? 'module' : 'modules' %>.
                    </p>
                </div>
            </div>

            <% if (modules.length===0) { %>
                <div class="py-12 text-center text-neutral-400 text-sm font-semibold">
                    No lessons have been published for this course yet. Check back soon!
                </div>
                <% } else { %>
                    <div class="space-y-4">
                        <% modules.forEach((module, modIdx)=> { %>
                            <div class="border border-neutral-200 rounded-xl overflow-hidden">
                                <div
                                    class="bg-neutral-50 px-5 py-3.5 border-b border-neutral-200 flex items-center justify-between">
                                    <h3 class="font-bold text-neutral-900 text-sm flex items-center gap-2">
                                        <span
                                            class="w-6 h-6 rounded-lg bg-black text-white text-xs flex items-center justify-center font-bold">
                                            <%= modIdx + 1 %>
                                        </span>
                                        <%= module.name %>
                                    </h3>
                                    <span class="text-xs text-neutral-500 font-bold">
                                        <%= module.lessons.length %>
                                            <%= module.lessons.length===1 ? 'lesson' : 'lessons' %>
                                    </span>
                                </div>

                                <ul class="divide-y divide-neutral-100 bg-white">
                                    <% module.lessons.forEach(lesson=> { %>
                                        <li
                                            class="px-5 py-3.5 flex items-center justify-between hover:bg-neutral-50/70 transition-colors">
                                            <div class="flex items-center gap-3 min-w-0 pr-4">
                                                <span
                                                    class="w-6 h-6 rounded-full bg-neutral-100 text-neutral-600 flex items-center justify-center text-xs font-bold shrink-0">
                                                    <%= lesson.order %>
                                                </span>
                                                <div>
                                                    <p class="text-sm font-bold text-neutral-900">
                                                        <%= lesson.title %>
                                                    </p>
                                                    <% if (lesson.description) { %>
                                                        <p class="text-xs text-neutral-500 line-clamp-1 mt-0.5">
                                                            <%= lesson.description %>
                                                        </p>
                                                        <% } %>
                                                </div>
                                            </div>

                                            <div class="flex items-center gap-3 shrink-0">
                                                <% if (lesson.durationSeconds> 0) { %>
                                                    <span class="text-xs text-neutral-400 font-medium">
                                                        <%= Math.floor(lesson.durationSeconds / 60) %>:<%=
                                                                String(Math.floor(lesson.durationSeconds %
                                                                60)).padStart(2, '0' ) %>
                                                    </span>
                                                    <% } %>
                                                        <% if (lesson.isFreePreview) { %>
                                                            <span
                                                                class="text-[11px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-md flex items-center gap-1">
                                                                Free Preview
                                                            </span>
                                                            <% } else { %>
                                                                <span
                                                                    class="text-xs text-neutral-400 font-semibold flex items-center gap-1"
                                                                    title="Locked lesson">
                                                                    <svg class="w-3.5 h-3.5" fill="currentColor"
                                                                        viewBox="0 0 20 20">
                                                                        <path fill-rule="evenodd"
                                                                            d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z"
                                                                            clip-rule="evenodd" />
                                                                    </svg>
                                                                    Protected
                                                                </span>
                                                                <% } %>
                                            </div>
                                        </li>
                                        <% }) %>
                                </ul>
                            </div>
                            <% }) %>
                    </div>
                    <% } %>
        </section>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-neutral-200 py-6 mt-12 text-xs text-neutral-500">
        <div
            class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
            <p>© <%= new Date().getFullYear() %> EDUviber. All rights reserved.</p>
            <div class="flex items-center gap-6 font-semibold text-neutral-600">
                <a href="/app" class="hover:text-black transition">Home</a>
                <a href="/courses" class="hover:text-black transition">All Courses</a>
                <a href="/app/login" class="hover:text-black transition">Sign In</a>
            </div>
        </div>
    </footer>
</body>

</html>