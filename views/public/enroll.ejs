<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Enroll in <%= course.title %> | EDUviber</title>
    <link rel="icon" type="image/png" href="/images/EDUviber_LOGO.png">
    <link rel="apple-touch-icon" href="/images/EDUviber_LOGO.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ["'Plus Jakarta Sans'", "sans-serif"],
                    },
                    colors: {
                        gold: "#CA8A04",
                        goldHover: "#A16207",
                    }
                }
            }
        }
    </script>
</head>

<body
    class="bg-[#FAFAFA] text-neutral-900 min-h-screen flex flex-col font-sans antialiased selection:bg-[#CA8A04] selection:text-white">
    <!-- Header -->
    <header class="bg-white/90 backdrop-blur-md border-b border-neutral-200 sticky top-0 z-30">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
            <a href="/app" class="font-black text-2xl tracking-tight text-black flex items-center gap-1 select-none">
                EDU<span class="text-[#CA8A04]">viber</span>
            </a>

            <nav class="flex items-center gap-4">
                <a href="/courses/<%= course.slug %>"
                    class="text-xs font-bold uppercase tracking-wider text-neutral-600 hover:text-black transition min-h-[36px] flex items-center">
                    ← Back to Course
                </a>
            </nav>
        </div>
    </header>

    <main class="max-w-3xl mx-auto px-4 sm:px-6 py-10 flex-1 w-full space-y-8">
        <div>
            <div
                class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#CA8A04]/10 border border-[#CA8A04]/20 text-[#CA8A04] text-xs font-bold mb-3">
                <span class="w-1.5 h-1.5 rounded-full bg-[#CA8A04]"></span>
                Course Enrollment & Manual Verification
            </div>
            <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-neutral-900">
                Payment & Transfer Instructions
            </h1>
            <p class="text-neutral-500 text-sm mt-1 font-medium">
                Complete your transfer using the banking details below, then submit your transaction reference to
                activate course access.
            </p>
        </div>

        <% if (rejectedPayment) { %>
            <div class="bg-rose-50 border border-rose-200 text-rose-900 rounded-2xl p-5 text-sm space-y-2">
                <div class="flex items-center gap-2 font-bold text-rose-800">
                    <span class="w-2.5 h-2.5 rounded-full bg-rose-600"></span>
                    Previous Submission Declined
                </div>
                <p class="text-xs text-rose-800">
                    Your previous payment submission (Ref: <strong
                        class="font-mono bg-rose-100 px-1.5 py-0.5 rounded text-rose-900">
                        <%= rejectedPayment.transactionReference %>
                    </strong>) on <%= new Date(rejectedPayment.createdAt).toLocaleDateString() %> was not approved.
                </p>
                <% if (rejectedPayment.rejectionReason) { %>
                    <div class="bg-white border border-rose-200 rounded-xl p-3 text-xs text-rose-800">
                        <strong>Reason provided by administrator:</strong>
                        <p class="mt-0.5">
                            <%= rejectedPayment.rejectionReason %>
                        </p>
                    </div>
                    <% } %>
                        <p class="text-xs text-rose-700 font-semibold pt-1">
                            Please double-check your receipt, confirm the payment details below, and submit a corrected
                            reference.
                        </p>
            </div>
            <% } %>

                <% if (pendingPayment) { %>
                    <div class="bg-amber-50 border border-amber-200 text-amber-900 rounded-2xl p-5 text-sm space-y-2">
                        <div class="flex items-center gap-2 font-bold text-amber-800">
                            <span class="w-2.5 h-2.5 rounded-full bg-[#CA8A04]"></span>
                            Verification Currently Pending
                        </div>
                        <p class="text-xs text-amber-800">
                            You have a pending transaction submission: <strong
                                class="font-mono bg-amber-100 px-2 py-0.5 rounded text-amber-950">
                                <%= pendingPayment.transactionReference %>
                            </strong> submitted on <%= new Date(pendingPayment.createdAt).toLocaleDateString() %>.
                        </p>
                        <p class="text-xs text-amber-700 font-medium">
                            Our team is currently reviewing your payment. If you need to submit an amended reference or
                            proof, you may resubmit using the form below.
                        </p>
                    </div>
                    <% } %>

                        <% if (error) { %>
                            <div role="alert"
                                class="bg-rose-50 border border-rose-200 text-rose-700 font-semibold rounded-2xl p-4 text-sm">
                                <%= error %>
                            </div>
                            <% } %>

                                <!-- Course Summary Card -->
                                <div
                                    class="bg-white border border-neutral-200/80 rounded-2xl p-6 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                                    <div>
                                        <span
                                            class="text-xs font-bold text-neutral-400 uppercase tracking-wider">Enrolling
                                            In</span>
                                        <h2 class="text-xl font-black text-neutral-900 mt-0.5">
                                            <%= course.title %>
                                        </h2>
                                        <p class="text-xs text-neutral-500 mt-1 font-medium">Student account: <strong
                                                class="text-neutral-900 font-bold">
                                                <%= user.email %>
                                            </strong></p>
                                    </div>
                                    <div
                                        class="text-left sm:text-right border-t sm:border-t-0 pt-3 sm:pt-0 border-neutral-100">
                                        <span
                                            class="text-xs text-neutral-400 uppercase font-bold tracking-wider">Payable
                                            Amount</span>
                                        <p class="text-3xl font-black text-neutral-900">₹<%=
                                                course.price.toLocaleString("en-IN") %>
                                        </p>
                                    </div>
                                </div>

                                <!-- Payment Instructions Box -->
                                <div class="bg-white border border-neutral-200/80 rounded-2xl p-6 shadow-xs space-y-5">
                                    <h3 class="font-bold text-neutral-900 text-base flex items-center gap-2">
                                        <span
                                            class="w-6 h-6 rounded-full bg-black text-white text-xs flex items-center justify-center font-bold">1</span>
                                        Step 1: Transfer Payment
                                    </h3>

                                    <p class="text-sm text-neutral-600 leading-relaxed font-medium">
                                        Please transfer the exact fee of <strong>₹<%=
                                                course.price.toLocaleString("en-IN") %></strong> using any UPI
                                        application (Google Pay, PhonePe, Paytm, BHIM) or NEFT/IMPS bank transfer:
                                    </p>

                                    <div
                                        class="grid grid-cols-1 sm:grid-cols-2 gap-4 bg-neutral-50 border border-neutral-200 rounded-xl p-4 text-sm font-mono">
                                        <div>
                                            <span
                                                class="text-xs text-neutral-500 block uppercase font-sans font-bold">UPI
                                                ID / VPA</span>
                                            <span class="font-black text-neutral-900 select-all">
                                                <%= paymentConfig.upiId %>
                                            </span>
                                        </div>
                                        <div>
                                            <span
                                                class="text-xs text-neutral-500 block uppercase font-sans font-bold">Account
                                                Holder Name</span>
                                            <span class="font-bold text-neutral-900 font-sans">
                                                <%= paymentConfig.accountName %>
                                            </span>
                                        </div>
                                        <div>
                                            <span
                                                class="text-xs text-neutral-500 block uppercase font-sans font-bold">Bank
                                                Name</span>
                                            <span class="font-bold text-neutral-900 font-sans">
                                                <%= paymentConfig.bankName %>
                                            </span>
                                        </div>
                                        <div>
                                            <span
                                                class="text-xs text-neutral-500 block uppercase font-sans font-bold">Account
                                                / IFSC</span>
                                            <span class="font-black text-neutral-900 select-all">
                                                <%= paymentConfig.accountNumber %> (<%= paymentConfig.ifscCode %>)
                                            </span>
                                        </div>
                                    </div>

                                    <div
                                        class="text-xs text-neutral-600 bg-[#CA8A04]/10 border border-[#CA8A04]/20 rounded-xl p-3.5 space-y-1 font-medium">
                                        <p class="font-bold text-neutral-900">Important Payment Details:</p>
                                        <p>• Save the 12-digit UPI UTR / Transaction ID or IMPS bank reference from your
                                            payment confirmation screen.</p>
                                        <p>• EDUviber will never ask for your debit card PIN, passwords, or OTPs.</p>
                                    </div>
                                </div>

                                <!-- Submission Form -->
                                <form id="enroll-form" action="/courses/<%= course.slug %>/enroll" method="POST"
                                    class="bg-white border border-neutral-200/80 rounded-2xl p-6 shadow-xs space-y-5">
                                    <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                                    <h3 class="font-bold text-neutral-900 text-base flex items-center gap-2">
                                        <span
                                            class="w-6 h-6 rounded-full bg-black text-white text-xs flex items-center justify-center font-bold">2</span>
                                        Step 2: Submit Transaction Reference
                                    </h3>

                                    <div>
                                        <label for="transactionReference"
                                            class="block text-sm font-bold text-neutral-800 mb-1.5">
                                            Transaction ID / UPI Reference (UTR) *
                                        </label>
                                        <input id="transactionReference" name="transactionReference" type="text"
                                            required maxlength="100" placeholder="e.g. 402918239012 or IMPS-99214488"
                                            value="<%= values.transactionReference || '' %>"
                                            class="w-full border border-neutral-300 rounded-xl p-3 text-sm focus:ring-2 focus:ring-[#CA8A04] focus:border-[#CA8A04] outline-none font-mono min-h-[44px]">
                                        <p class="text-xs text-neutral-400 mt-1.5 font-medium">
                                            Found on your banking app or UPI payment receipt.
                                        </p>
                                    </div>

                                    <!-- Optional Proof File or Link -->
                                    <div class="space-y-4 pt-3 border-t border-neutral-100">
                                        <label class="block text-sm font-bold text-neutral-800 mb-1">
                                            Payment Receipt Proof (Optional)
                                        </label>

                                        <div>
                                            <label for="proofFile"
                                                class="block text-xs font-semibold text-neutral-600 mb-1.5">
                                                Upload Screenshot (PNG, JPEG, or WebP up to 2.5 MB)
                                            </label>
                                            <input id="proofFile" type="file" accept="image/png,image/jpeg,image/webp"
                                                class="w-full text-xs text-neutral-600 file:mr-3 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-neutral-100 file:text-neutral-800 hover:file:bg-neutral-200 transition">
                                            <input type="hidden" id="proofData" name="proofData" value="">
                                        </div>

                                        <div
                                            class="text-center text-xs text-neutral-400 font-bold uppercase tracking-wider">
                                            — OR —</div>

                                        <div>
                                            <label for="proofUrl"
                                                class="block text-xs font-semibold text-neutral-600 mb-1.5">
                                                Link from Cloud Storage (Google Drive, Dropbox, OneDrive)
                                            </label>
                                            <input id="proofUrl" name="proofUrl" type="url" maxlength="2048"
                                                placeholder="https://drive.google.com/file/d/..."
                                                value="<%= values.proofUrl || '' %>"
                                                class="w-full border border-neutral-300 rounded-xl p-3 text-sm focus:ring-2 focus:ring-[#CA8A04] focus:border-[#CA8A04] outline-none min-h-[44px]">
                                        </div>
                                    </div>

                                    <div class="pt-2">
                                        <button type="submit"
                                            class="w-full bg-black hover:bg-neutral-800 text-white font-bold py-3.5 px-6 rounded-xl transition shadow-xs text-sm min-h-[44px]">
                                            Submit Payment for Admin Verification
                                        </button>
                                    </div>

                                    <p class="text-center text-xs text-neutral-400 font-medium">
                                        Payments are reviewed and verified manually. Course access is automatically
                                        activated once approved.
                                    </p>
                                </form>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-neutral-200 py-6 mt-12 text-xs text-neutral-500">
        <div class="max-w-4xl mx-auto px-4 text-center font-medium">
            <p>© <%= new Date().getFullYear() %> EDUviber. All rights reserved.</p>
        </div>
    </footer>

    <script>
        const fileInput = document.getElementById("proofFile");
        const proofDataInput = document.getElementById("proofData");
        const form = document.getElementById("enroll-form");

        if (fileInput) {
            fileInput.addEventListener("change", function () {
                const file = fileInput.files[0];
                if (!file) {
                    proofDataInput.value = "";
                    return;
                }
                if (file.size > 2.5 * 1024 * 1024) {
                    alert("Please select an image smaller than 2.5 MB.");
                    fileInput.value = "";
                    proofDataInput.value = "";
                    return;
                }
                const reader = new FileReader();
                reader.onload = function (e) {
                    proofDataInput.value = e.target.result;
                };
                reader.readAsDataURL(file);
            });
        }
    </script>
</body>

</html>