<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Course Catalogue | EDUviber</title>
    <meta name="description" content="Explore our library of published professional courses. Step-by-step curriculum with practical video modules.">
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col antialiased">
    <!-- Navigation Bar -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-30 shadow-xs">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
            <a href="/" class="font-bold text-2xl tracking-tight text-gray-900 flex items-center gap-1">
                EDUviber<span class="text-yellow-600">.</span>
            </a>

            <nav class="flex items-center gap-4 sm:gap-6">
                <a href="/courses" class="text-sm font-semibold text-yellow-700">
                    All Courses
                </a>

                <% if (user) { %>
                    <a href="<%= user.role === 'admin' ? '/admin' : '/dashboard' %>"
                        class="inline-flex items-center gap-2 bg-gray-900 hover:bg-black text-white text-sm font-medium px-4 py-2 rounded-xl transition-colors shadow-xs">
                        <span>Dashboard</span>
                        <span class="text-xs text-yellow-400">→</span>
                    </a>
                <% } else { %>
                    <a href="/login"
                        class="text-sm font-medium text-gray-700 hover:text-gray-900 transition-colors">
                        Sign In
                    </a>
                <% } %>
            </nav>
        </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 py-12 flex-1 w-full">
        <div class="mb-10">
            <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-gray-900">
                Course Catalogue
            </h1>
            <p class="text-gray-500 mt-2 text-base max-w-xl">
                Browse our verified, published curriculums. Every course features structured lessons, high-definition streaming, and progress tracking.
            </p>
        </div>

        <% if (courses.length === 0) { %>
            <div class="bg-white border border-gray-200 rounded-2xl p-16 text-center max-w-md mx-auto shadow-xs my-12">
                <div class="w-16 h-16 bg-yellow-50 text-yellow-600 rounded-2xl flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                            d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                    </svg>
                </div>
                <h2 class="text-xl font-bold text-gray-900">No Courses Available Yet</h2>
                <p class="text-gray-500 mt-2 text-sm leading-relaxed">
                    Check back soon as new lessons and programs are being actively finalized.
                </p>
                <a href="/" class="inline-block mt-6 text-sm font-medium text-yellow-700 hover:text-yellow-800">
                    ← Return to Home
                </a>
            </div>
        <% } else { %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <% courses.forEach(course => { %>
                    <article class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-xs hover:border-gray-300 hover:shadow-md transition-all flex flex-col justify-between">
                        <!-- Course Banner -->
                        <div class="relative w-full h-48 bg-gradient-to-br from-gray-900 via-gray-800 to-yellow-950 overflow-hidden">
                            <% if (course.thumbnail) { %>
                                <img src="<%= course.thumbnail %>" alt="<%= course.title %>"
                                    class="w-full h-full object-cover"
                                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                <div class="hidden w-full h-full items-center justify-center p-6 text-white text-center">
                                    <p class="text-lg font-bold"><%= course.title %></p>
                                </div>
                            <% } else { %>
                                <div class="w-full h-full flex flex-col items-center justify-center p-6 text-white text-center">
                                    <span class="text-2xl font-extrabold text-yellow-500">EDUviber.</span>
                                    <p class="text-base font-semibold mt-1 px-4 line-clamp-2"><%= course.title %></p>
                                </div>
                            <% } %>

                            <div class="absolute bottom-3 right-3 bg-black/75 backdrop-blur-xs text-white text-xs px-2.5 py-1 rounded-md font-medium">
                                <%= course.lessonCount %> <%= course.lessonCount === 1 ? 'lesson' : 'lessons' %>
                                <% if (course.totalMinutes > 0) { %> • <%= course.totalMinutes %>m<% } %>
                            </div>
                        </div>

                        <!-- Course Info -->
                        <div class="p-6 flex-1 flex flex-col justify-between">
                            <div>
                                <% if (course.instructor) { %>
                                    <p class="text-xs font-medium text-yellow-700 uppercase tracking-wider mb-1">
                                        Instructor: <%= course.instructor %>
                                    </p>
                                <% } %>

                                <h2 class="text-xl font-bold text-gray-900 leading-snug">
                                    <a href="/courses/<%= course.slug %>" class="hover:underline">
                                        <%= course.title %>
                                    </a>
                                </h2>

                                <p class="text-sm text-gray-600 mt-2 line-clamp-3 leading-relaxed">
                                    <%= course.description %>
                                </p>
                            </div>

                            <div class="mt-6 pt-5 border-t border-gray-100 flex items-center justify-between">
                                <div>
                                    <span class="text-xs text-gray-400 block font-medium">Price</span>
                                    <span class="text-2xl font-bold text-gray-900">
                                        ₹<%= course.price.toLocaleString("en-IN") %>
                                    </span>
                                </div>

                                <a href="/courses/<%= course.slug %>"
                                    class="bg-gray-900 hover:bg-black text-white text-sm font-medium px-5 py-2.5 rounded-xl transition-colors shadow-xs">
                                    View Syllabus →
                                </a>
                            </div>
                        </div>
                    </article>
                <% }) %>
            </div>
        <% } %>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-gray-200 py-8 mt-12">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-500">
            <p>© <%= new Date().getFullYear() %> EDUviber. All rights reserved.</p>
            <div class="flex items-center gap-6">
                <a href="/" class="hover:text-gray-900 transition-colors">Home</a>
                <a href="/login" class="hover:text-gray-900 transition-colors">Sign In</a>
            </div>
        </div>
    </footer>
</body>

</html>
